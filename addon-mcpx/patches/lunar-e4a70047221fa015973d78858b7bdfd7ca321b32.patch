@@ -12,7 +17,41 @@ export const axiosClient = axios.create({
 });
 
 axiosClient.interceptors.request.use((config) => {
+  const authKey = getStoredAuthKey();
+  if (authKey) {
+    config.headers.set("x-lunar-api-key", authKey);
+  }
   // Re-evaluate enterprise flag for every request so runtime config changes apply
   config.withCredentials = isEnterpriseEnabled();
   return config;
 });
+
+axiosClient.interceptors.response.use(
+  (response) => response,
+  async (error) => {
+    const config = error.config;
+    const isMissingKey = error.response?.status === 401;
+    const isInvalidKey =
+      error.response?.status === 403 &&
+      typeof error.response.data === "string" &&
+      error.response.data.includes("Invalid API key");
+
+    if (
+      (isMissingKey || isInvalidKey) &&
+      config &&
+      !(config as { _mcpxAuthRetried?: boolean })._mcpxAuthRetried
+    ) {
+      if (isInvalidKey) {
+        forgetStoredAuthKey();
+      }
+      const authKey = promptForAuthKey();
+      if (authKey) {
+        (config as { _mcpxAuthRetried?: boolean })._mcpxAuthRetried = true;
+        config.headers.set("x-lunar-api-key", authKey);
+        return axiosClient.request(config);
+      }
+    }
+
+    return Promise.reject(error);
+  },
+);
