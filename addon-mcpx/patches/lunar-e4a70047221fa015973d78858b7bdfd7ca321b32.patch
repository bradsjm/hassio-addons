diff --git a/mcpx/packages/ui/src/data/auth-key.ts b/mcpx/packages/ui/src/data/auth-key.ts
new file mode 100644
index 00000000..aa34b72d
--- /dev/null
+++ b/mcpx/packages/ui/src/data/auth-key.ts
@@ -0,0 +1,19 @@
+const STORAGE_KEY = "mcpx-auth-key";
+
+export function getStoredAuthKey(): string | null {
+  return window.localStorage.getItem(STORAGE_KEY);
+}
+
+export function forgetStoredAuthKey(): void {
+  window.localStorage.removeItem(STORAGE_KEY);
+}
+
+export function promptForAuthKey(): string | null {
+  const authKey = window.prompt("MCPX auth key");
+  if (!authKey) {
+    return null;
+  }
+
+  window.localStorage.setItem(STORAGE_KEY, authKey);
+  return authKey;
+}
