#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the OpenChamber service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

set -e

declare port
declare password
declare opencode_mode
declare opencode_host
declare opencode_port
declare opencode_version
declare opencode_expose
declare opencode_bind
declare openchamber_version
declare openchamber_data_dir
declare env_entry
declare binary_path
declare opencode_pid
declare runtime_home
declare runtime_cache
declare runtime_opencode_config
declare runtime_xdg_config
declare runtime_xdg_data
declare runtime_npm_cache
declare runtime_npm_prefix
declare runtime_bun_install
declare runtime_bun_cache
declare -a args

log_binary_diagnostics() {
  local ls_output
  local ldd_output

  bashio::log.error "OpenCode execution diagnostics"
  bashio::log.error "Architecture: $(uname -m)"

  if [[ -e "${binary_path}" ]]; then
    ls_output=$(ls -l "${binary_path}" 2>&1 || true)
    bashio::log.error "Binary details: ${ls_output}"
    ldd_output=$(ldd "${binary_path}" 2>&1 || true)
    while IFS= read -r line; do
      bashio::log.error "ldd: ${line}"
    done <<< "${ldd_output}"
  else
    bashio::log.error "Binary path not found: ${binary_path}"
  fi
}

install_opencode() {
  local requested_version=${1:-}
  local installer_script

  installer_script=$(mktemp)

  if ! curl -fsSL --retry 3 --retry-delay 2 --max-time 60 -o "${installer_script}" https://opencode.ai/install; then
    rm -f "${installer_script}"
    return 1
  fi

  if [[ -n "${requested_version}" ]]; then
    if ! HOME="${HOME}" bash "${installer_script}" --no-modify-path --version "${requested_version}"; then
      rm -f "${installer_script}"
      return 1
    fi
  else
    if ! HOME="${HOME}" bash "${installer_script}" --no-modify-path; then
      rm -f "${installer_script}"
      return 1
    fi
  fi

  rm -f "${installer_script}"
}

install_openchamber() {
  local requested_version=${1:-}
  local package="@openchamber/web"

  if [[ -n "${requested_version}" ]]; then
    package="${package}@${requested_version}"
  fi

  bashio::log.info "Installing OpenChamber ${package}"
  if ! npm install -g "${package}"; then
    return 1
  fi
}

wait_for_opencode() {
  local max_attempts=30
  local attempt=1
  local -a curl_args

  bashio::log.info "Waiting for OpenCode server on port ${opencode_port}"

  curl_args=(-s -f)
  if [[ -n "${password}" && "${password}" != "null" ]]; then
    curl_args+=(-u "opencode:${password}")
  fi

  while [[ ${attempt} -le ${max_attempts} ]]; do
    if curl "${curl_args[@]}" "http://127.0.0.1:${opencode_port}/global/health" > /dev/null 2>&1; then
      bashio::log.info "OpenCode server is ready"
      return 0
    fi
    sleep 2
    attempt=$((attempt + 1))
  done

  bashio::log.error "OpenCode server failed to start within timeout"
  return 1
}

# Read config first so paths are resolved correctly
port=$(bashio::config 'openchamber.port')
password=$(bashio::config 'password')
opencode_mode=$(bashio::config 'opencode.mode')
opencode_host=$(bashio::config 'opencode.host')
opencode_port=$(bashio::config 'opencode.port' 4096)
opencode_expose=$(bashio::config 'opencode.expose' 'false')
opencode_version=$(bashio::config 'opencode.version')
openchamber_version=$(bashio::config 'openchamber.version')
openchamber_data_dir=$(bashio::config 'openchamber.data_dir' '/data/openchamber')

if [[ "${opencode_host}" == "null" ]]; then
  opencode_host=""
fi

if [[ "${opencode_version}" == "null" ]]; then
  opencode_version=""
fi

if [[ "${openchamber_version}" == "null" ]]; then
  openchamber_version=""
fi

opencode_version=${opencode_version#v}
openchamber_version=${openchamber_version#v}

# Resolve OpenCode bind address
opencode_bind="127.0.0.1"
if bashio::var.true "${opencode_expose}"; then
  opencode_bind="0.0.0.0"
fi

runtime_home=/data
runtime_cache=${runtime_home}/cache
runtime_opencode_config=${runtime_home}/.config/opencode
runtime_xdg_config=${runtime_home}/.config
runtime_xdg_data=${runtime_home}/.local/share
runtime_npm_cache=${runtime_home}/npm-cache
runtime_npm_prefix=${runtime_home}/npm-global
runtime_bun_install=${runtime_home}/bun
runtime_bun_cache=${runtime_home}/bun-cache

mkdir -p "${runtime_home}" "${runtime_cache}" "${runtime_opencode_config}" "${runtime_xdg_config}" "${runtime_xdg_data}" "${runtime_npm_cache}" "${runtime_npm_prefix}" "${runtime_bun_install}" "${runtime_bun_cache}" "${openchamber_data_dir}"
mkdir -p "${runtime_npm_prefix}/bin"
mkdir -p "${runtime_npm_prefix}/lib"

export OPENCODE_CONFIG_DIR="${runtime_opencode_config}"
export OPENCODE_CONFIG="${runtime_opencode_config}/opencode.json"
export HOMEASSISTANT_URL=http://supervisor/core
export HOMEASSISTANT_TOKEN=${SUPERVISOR_TOKEN}
export HOME="${runtime_home}"
export XDG_CACHE_HOME="${runtime_cache}"
export XDG_CONFIG_HOME="${runtime_xdg_config}"
export XDG_DATA_HOME="${runtime_xdg_data}"
export OPENCODE_DISABLE_AUTOUPDATE=true
export NPM_CONFIG_CACHE="${runtime_npm_cache}"
export NPM_CONFIG_PREFIX="${runtime_npm_prefix}"
export BUN_INSTALL="${runtime_bun_install}"
export BUN_INSTALL_CACHE_DIR="${runtime_bun_cache}"
export PATH="${HOME}/.opencode/bin:${runtime_npm_prefix}/bin:${PATH}"
export OPENCHAMBER_DATA_DIR="${openchamber_data_dir}"

if bashio::config.has_value 'opencode.env_vars'; then
  while IFS= read -r env_entry; do
    if [[ -z "${env_entry}" ]]; then
      continue
    fi

    if [[ ! "${env_entry}" =~ ^OPENCODE_[A-Z0-9_]+=.*$ ]]; then
      bashio::log.warning "Skipping invalid OpenCode environment entry: ${env_entry}"
      continue
    fi

    export "${env_entry}"
    bashio::log.info "Applied OpenCode environment override: ${env_entry%%=*}"
  done <<< "$(bashio::config 'opencode.env_vars')"
fi

# Set shared password for both OpenCode server auth and OpenChamber UI
if [[ -n "${password}" && "${password}" != "null" ]]; then
  export OPENCODE_SERVER_USERNAME="opencode"
  export OPENCODE_SERVER_PASSWORD="${password}"
fi

if [[ "${opencode_mode}" == "external" ]] && [[ -z "${opencode_host}" ]]; then
  bashio::exit.nok "opencode.mode is 'external' but opencode.host is empty. Set opencode.host to your OpenCode server URL."
fi

if bashio::config.has_value 'packages'; then
    apt update \
        || bashio::exit.nok 'Failed updating Ubuntu packages repository indexes'

    for package in $(bashio::config 'packages'); do
        apt-get install -y "$package" \
            || bashio::exit.nok "Failed installing package ${package}"
    done
fi

if bashio::config.has_value 'init_commands'; then
    while read -r cmd; do
        eval "${cmd}" \
            || bashio::exit.nok "Failed executing init command: ${cmd}"
    done <<< "$(bashio::config 'init_commands')"
fi

sshd="${HOME}/.ssh"
ssh_private_key="${sshd}/id_ed25519"
ssh_public_key="${ssh_private_key}.pub"

mkdir -p "${sshd}"
chmod 700 "${sshd}" 2>/dev/null || true

if [[ ! -f "${ssh_private_key}" || ! -f "${ssh_public_key}" ]]; then
  if [[ -w "${sshd}" ]]; then
    bashio::log.info "Generating SSH key..."
    if ssh-keygen -t ed25519 -N "" -f "${ssh_private_key}" >/dev/null 2>&1; then
      chmod 600 "${ssh_private_key}" 2>/dev/null || true
      chmod 644 "${ssh_public_key}" 2>/dev/null || true
      bashio::log.info "SSH public key:"
      while IFS= read -r line; do
        bashio::log.info "${line}"
      done < "${ssh_public_key}"
    else
      bashio::log.warning "Failed to generate SSH key, continuing without"
    fi
  else
    bashio::log.warning "SSH key missing and ${sshd} is not writable, continuing without"
  fi
elif [[ -f "${ssh_public_key}" ]]; then
  bashio::log.info "Existing SSH public key:"
  while IFS= read -r line; do
    bashio::log.info "${line}"
  done < "${ssh_public_key}"
fi

if [[ "${opencode_mode}" == "managed" ]]; then
  if [[ ! -f "${runtime_opencode_config}/opencode.json" ]] && [[ -f /root/.opencode/opencode.json ]]; then
    cp /root/.opencode/opencode.json "${runtime_opencode_config}/opencode.json"
  fi

  if [[ ! -f "${runtime_opencode_config}/AGENTS.md" ]] && [[ -f /root/.opencode/AGENTS.md ]]; then
    cp /root/.opencode/AGENTS.md "${runtime_opencode_config}/AGENTS.md"
  fi

  binary_path="${HOME}/.opencode/bin/opencode"

  if [[ -n "${opencode_version}" ]]; then
    bashio::log.info "Installing pinned OpenCode version ${opencode_version}"
    if ! install_opencode "${opencode_version}"; then
      bashio::exit.nok "Failed to install pinned OpenCode version ${opencode_version}"
    fi
  else
    bashio::log.info "Installing latest OpenCode release"
    if ! install_opencode; then
      if [[ -x "${binary_path}" ]]; then
        bashio::log.warning 'Latest install failed, continuing with existing binary'
      else
        bashio::exit.nok 'Failed to install latest OpenCode release'
      fi
    fi
  fi

  if [[ ! -x "${binary_path}" ]]; then
    log_binary_diagnostics
    bashio::exit.nok 'OpenCode binary is missing after install attempt'
  fi

  if ! "${binary_path}" --version >/dev/null 2>&1; then
    log_binary_diagnostics
    bashio::exit.nok 'OpenCode binary failed to execute'
  fi

  npx skills add homeassistant-ai/skills -g -a opencode -y
  npx skills add https://github.com/bradsjm/hassio-addons/addon-opencode/skills -g -a opencode -y

  if ! "${binary_path}" models --refresh; then
    bashio::log.warning 'Failed to refresh models, continuing startup'
  fi

  bashio::log.info "Starting OpenCode headless API server on port ${opencode_port}"
  "${binary_path}" serve --port "${opencode_port}" --hostname "${opencode_bind}" &
  opencode_pid=$!

  if ! wait_for_opencode; then
    kill "${opencode_pid}" 2>/dev/null || true
    bashio::exit.nok 'OpenCode server failed to start'
  fi
fi

if [[ -n "${openchamber_version}" ]]; then
  bashio::log.info "Installing pinned OpenChamber version ${openchamber_version}"
  if ! install_openchamber "${openchamber_version}"; then
    bashio::exit.nok "Failed to install pinned OpenChamber version ${openchamber_version}"
  fi
else
  bashio::log.info "Installing latest OpenChamber release"
  if ! install_openchamber; then
    bashio::exit.nok 'Failed to install latest OpenChamber release'
  fi
fi

export OPENCODE_SKIP_START=true

if [[ "${opencode_mode}" == "managed" ]]; then
  export OPENCODE_HOST="http://127.0.0.1:${opencode_port}"
  export OPENCODE_PORT="${opencode_port}"
elif [[ -n "${opencode_host}" ]]; then
  export OPENCODE_HOST="${opencode_host}"
  if [[ -n "${opencode_port}" && "${opencode_port}" != "null" ]]; then
    export OPENCODE_PORT="${opencode_port}"
  fi
  bashio::log.info "Using external OpenCode at ${opencode_host}"
fi

export OPENCHAMBER_HOST="0.0.0.0"

args=("serve" "--foreground" "--host" "0.0.0.0" "--port" "${port}")

if [[ -n "${password}" && "${password}" != "null" ]]; then
  args+=("--ui-password" "${password}")
fi

cd /config
bashio::log.info "Starting OpenChamber server on port ${port}"
exec openchamber "${args[@]}"
